{
  "name": "gather-distributed",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "gather-distributed",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
