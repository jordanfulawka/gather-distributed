    },
    "packages/shared-types": {
      "name": "@gather/shared-types",
      "version": "1.0.0",
      "license": "ISC"
    },
    "packages/socket-events": {
      "name": "@gather/socket-events",
      "version": "1.0.0",
      "license": "ISC"
    }
  }
